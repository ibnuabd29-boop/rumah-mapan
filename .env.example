NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key dari Supabase. Jangan gunakan secret/service_role di sini.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Notifikasi push (opsional). Buat dengan: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=mailto:admin@example.com
CRON_SECRET=
PENGINGAT_SCHEDULED=false

# Hanya untuk server. Jangan beri awalan NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Kunci enkripsi token Google Drive. Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DRIVE_ENC_KEY=

# Google OAuth untuk folder foto bukti admin.
# Redirect lokal: http://localhost:3000/api/drive/callback
# Redirect produksi: https://rumah-mapan.vercel.app/api/drive/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
